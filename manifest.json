{
  "manifest_version": 3,
  "name": "Prompts Organizer",
  "version": "1.1",
  "description": "A Chrome extension to organize ChatGPT, Claude, DeepSeek, and Gemini chats into folders.",
  "permissions": ["storage", "scripting", "tabs"],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://claude.ai/*",
    "https://chat.deepseek.com/*",
    "https://gemini.google.com/*"
  ],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://claude.ai/*",
        "https://chat.deepseek.com/*",
        "https://gemini.google.com/*"
      ],
      "js": [
        "platforms/chatgpt.js",
        "platforms/claude.js",
        "platforms/deepseek.js",
        "platforms/gemini.js",
        "content.js"
      ]
    }
  ],
  "icons": {
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "styles.css",
        "platforms/chatgpt.css",
        "platforms/claude.css",
        "platforms/deepseek.css",
        "platforms/gemini.css",
        "assets/fonts/Inter-Variable.ttf"
      ],
      "matches": ["<all_urls>"]
    }
  ]
}
